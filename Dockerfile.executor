# Build stage - compile Kestra from source
FROM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /build

# Copy gradle wrapper and configuration files
COPY gradlew ./
COPY gradle ./gradle
COPY gradle.properties ./
COPY settings.gradle ./
COPY build.gradle ./

# Copy source code
COPY cli ./cli
COPY core ./core
COPY jdbc ./jdbc
COPY jdbc-h2 ./jdbc-h2
COPY jdbc-mysql ./jdbc-mysql
COPY jdbc-postgres ./jdbc-postgres
COPY repository-postgres ./repository-postgres
COPY repository-mysql ./repository-mysql
COPY runner-kafka ./runner-kafka
COPY runner-memory ./runner-memory
COPY storage-gcs ./storage-gcs
COPY storage-local ./storage-local
COPY storage-minio ./storage-minio
COPY storage-s3 ./storage-s3
COPY webserver ./webserver
COPY ui ./ui
COPY platform ./platform
COPY gradle/jar ./gradle/jar

# Build the executable jar
RUN ./gradlew writeExecutableJar --no-daemon --parallel

# Runtime stage - minimal image for running executor
FROM eclipse-temurin:21-jre-jammy

ARG KESTRA_PLUGINS=""
ARG APT_PACKAGES=""
ARG PYTHON_LIBRARIES=""

WORKDIR /app

RUN groupadd kestra && \
    useradd -m -g kestra kestra

# Copy docker configuration files
COPY docker /

# Copy built executable from builder stage
COPY --from=builder --chown=kestra:kestra /build/build/executable/kestra-* /app/kestra

# Install dependencies and plugins
RUN apt-get update -y && \
    apt-get upgrade -y && \
    if [ -n "${APT_PACKAGES}" ]; then apt-get install -y --no-install-recommends ${APT_PACKAGES}; fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/* && \
    curl -LsSf https://astral.sh/uv/0.6.17/install.sh | sh && mv /root/.local/bin/uv /bin && mv /root/.local/bin/uvx /bin && \
    if [ -n "${KESTRA_PLUGINS}" ]; then /app/kestra plugins install ${KESTRA_PLUGINS} && rm -rf /tmp/*; fi && \
    if [ -n "${PYTHON_LIBRARIES}" ]; then uv pip install --system ${PYTHON_LIBRARIES}; fi && \
    chown -R kestra:kestra /app

USER kestra

ENTRYPOINT ["docker-entrypoint.sh"]

# Default command runs the executor
CMD ["server", "executor"]
